rules_version = '2';

// Public site: anyone can read content that is published/enabled. Only the admin accounts below can write.
// Keep the email list in sync with ADMIN_EMAILS in .env.local.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['drpremagynaecologistcbe@gmail.com'];
    }

    match /blogs/{id} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    // Contact-page messages: anyone may submit one (well-formed, size-limited); only admins can read or manage them.
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'topic', 'message', 'isRead', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 60
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 3000
        && request.resource.data.isRead == false;
      allow read, update, delete: if isAdmin();
    }

    match /{collection}/{id} {
      allow read: if (collection in ['testimonials', 'gallery', 'publications', 'videos', 'guestLectures', 'awards'] && resource.data.isEnabled == true) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
