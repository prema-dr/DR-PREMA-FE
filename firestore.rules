rules_version = '2';

// Public site: anyone can read content that is published/enabled. Only the admin accounts below can write.
// Keep the email list in sync with ADMIN_EMAILS in .env.local.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['drpremagynaecologistcbe@gmail.com'];
    }

    match /blogs/{id} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    // Appointment bookings. A booking is two docs written in one atomic commit by /api/appointments:
    //  - bookedSlots/{date_HHMM}: the public "this time is taken" marker. Its id IS the date and time, and it can
    //    only be created (never overwritten), so a time can never be held twice.
    //  - appointments/{id}: the private record (patient details). Only admins can read or manage it.
    function slotId(d) { return d.date + '_' + d.time.replace(':', ''); }

    match /bookedSlots/{slot} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date', 'time', 'appointmentId'])
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time is string && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.appointmentId is string && request.resource.data.appointmentId.size() > 0 && request.resource.data.appointmentId.size() <= 64
        && slot == slotId(request.resource.data)
        && existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId));
      allow delete: if isAdmin();
    }

    match /appointments/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'topic', 'message', 'date', 'time', 'slotKey', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 60
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time is string && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.slotKey == slotId(request.resource.data)
        && request.resource.data.status == 'pending'
        && existsAfter(/databases/$(database)/documents/bookedSlots/$(request.resource.data.slotKey))
        && getAfter(/databases/$(database)/documents/bookedSlots/$(request.resource.data.slotKey)).data.appointmentId == id;
      allow read, update, delete: if isAdmin();
    }

    match /{collection}/{id} {
      allow read: if (collection in ['testimonials', 'gallery', 'publications', 'videos', 'guestLectures', 'awards'] && resource.data.isEnabled == true) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
